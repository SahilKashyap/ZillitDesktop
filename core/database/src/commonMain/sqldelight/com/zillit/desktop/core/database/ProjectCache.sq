-- Cached server data for the open production.
--
-- Typed rows with an explicit `cachedAt`, not JSON blobs in a preference file.
-- The Android client keeps `countryList`, `crewListResponse`, `projectLabels`
-- and friends as serialised strings in `SharedPref`, which has no TTL — so they
-- go stale silently and invalidation means deleting keys by hand.
--
-- Everything here is scoped by `projectId` and dropped on project switch.
--
-- The notice boards used to be here too, as a `cachedNotice` nothing ever
-- wrote to; they live in `NoticeCache.sq` now, which says why its rows keep
-- the server's own JSON and leave the post bodies encrypted.

CREATE TABLE cachedProfile (
    userId     TEXT NOT NULL PRIMARY KEY,
    projectId  TEXT NOT NULL,
    fullName   TEXT NOT NULL,
    -- Kept apart as well as joined: the profile form edits them separately,
    -- and splitting fullName back gets a two-word first name wrong.
    firstName  TEXT,
    lastName   TEXT,
    -- Where this person sits on the production. On the profile, not the crew
    -- list: `project/users` carries neither id, so the settings form had
    -- nothing to preselect from.
    departmentId    TEXT,
    departmentName  TEXT,
    designationId   TEXT,
    designationName TEXT,
    -- The stable keys the finance tools' rights rules match on; the names
    -- beside them are display keys. See ProfileSnapshot.departmentIdentifier.
    departmentIdentifier  TEXT,
    designationIdentifier TEXT,
    keepNamePrivate INTEGER NOT NULL DEFAULT 0,
    email      TEXT,
    phone      TEXT,
    avatarUrl  TEXT,
    isAdmin    INTEGER NOT NULL DEFAULT 0,
    joinUnitId   TEXT,
    joinUnitName TEXT,
    -- The Home unit this person asked to land on (`default_unit_id`); null
    -- lands them on the first tab, as on the phones.
    defaultUnitId TEXT,
    cachedAt   INTEGER NOT NULL
);

CREATE TABLE cachedProject (
    projectId   TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    code        TEXT NOT NULL,
    type        TEXT,
    subType     TEXT,
    companyName TEXT,
    -- Where this production's files go. `BOX`, or AWS when absent.
    storageType TEXT,
    enterpriseClientId TEXT,
    -- `name=id;name=id`. Neither part contains either separator.
    storageFolders TEXT NOT NULL DEFAULT '',
    -- The production this one is a remote unit *of*, when it is one. A remote
    -- unit cannot create further units, which is what Admin Settings reads it
    -- for (Android: `parentProjectName.isNullOrEmpty()`).
    parentName  TEXT,
    -- `mark_deleted`: this production is counting down to deletion. The admin
    -- row then offers to stop it rather than to start it again.
    markedForDeletion INTEGER NOT NULL DEFAULT 0,
    -- `language_code`: the production's working language. Chat's Translate
    -- offers itself only when this differs from the app's own language, as
    -- the web gates it (ZL-16953).
    languageCode TEXT,
    cachedAt    INTEGER NOT NULL
);

CREATE TABLE cachedProjectUser (
    userId      TEXT NOT NULL,
    projectId   TEXT NOT NULL,
    fullName    TEXT NOT NULL,
    email       TEXT,
    department  TEXT,
    designation TEXT,
    avatarUrl   TEXT,
    -- The member's primary device — what an Agora 1:1 call is addressed to.
    deviceId    TEXT,
    isAdmin     INTEGER NOT NULL DEFAULT 0,
    -- Set by the crew member at registration. Honoured wherever their name
    -- would be shown to the rest of the unit.
    keepNamePrivate INTEGER NOT NULL DEFAULT 0,
    cachedAt    INTEGER NOT NULL,
    PRIMARY KEY (projectId, userId)
);

CREATE TABLE cachedTool (
    identifier      TEXT NOT NULL,
    projectId       TEXT NOT NULL,
    groupIdentifier TEXT,
    unitId          TEXT,
    unitName        TEXT,
    enabled         INTEGER NOT NULL DEFAULT 1,
    canView         INTEGER NOT NULL DEFAULT 0,
    canPost         INTEGER NOT NULL DEFAULT 0,
    canDownload     INTEGER NOT NULL DEFAULT 0,
    isTool          INTEGER NOT NULL DEFAULT 1,
    onHome          INTEGER NOT NULL DEFAULT 0,
    ordinal         INTEGER NOT NULL,
    cachedAt        INTEGER NOT NULL,
    PRIMARY KEY (projectId, identifier, unitId)
);

-- profile ------------------------------------------------------------------
upsertProfile:
INSERT OR REPLACE INTO cachedProfile VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProfile:
SELECT * FROM cachedProfile WHERE projectId = ? LIMIT 1;

-- project ------------------------------------------------------------------
upsertProject:
INSERT OR REPLACE INTO cachedProject VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProject:
SELECT * FROM cachedProject WHERE projectId = ?;

-- users --------------------------------------------------------------------
upsertProjectUser:
INSERT OR REPLACE INTO cachedProjectUser VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProjectUsers:
SELECT * FROM cachedProjectUser WHERE projectId = ? ORDER BY fullName COLLATE NOCASE;

deleteProjectUsers:
DELETE FROM cachedProjectUser WHERE projectId = ?;

-- tools --------------------------------------------------------------------
upsertTool:
INSERT OR REPLACE INTO cachedTool VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTools:
SELECT * FROM cachedTool WHERE projectId = ? ORDER BY ordinal;

deleteTools:
DELETE FROM cachedTool WHERE projectId = ?;


-- wipe ---------------------------------------------------------------------
-- Called on project switch and sign-out. One statement per table rather than a
-- loop, so a table added later is a compile-time reminder to clear it too.
deleteProjectData:
DELETE FROM cachedProject WHERE projectId = ?;

deleteProfileData:
DELETE FROM cachedProfile WHERE projectId = ?;


-- sign-out: everything, every production ---------------------------------
deleteAllProfiles:
DELETE FROM cachedProfile;

deleteAllProjects:
DELETE FROM cachedProject;

deleteAllProjectUsers:
DELETE FROM cachedProjectUser;

deleteAllTools:
DELETE FROM cachedTool;

